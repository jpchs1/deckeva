#: src/Settings.php:108
msgctxt "Menu item"
msgid "WP Debugging"
msgstr "WP Debugging"

#: src/Bootstrap.php:89
msgid "The <strong>WP Debugging</strong> plugin must have a <code>wp-config.php</code> file that is writable by the filesystem."
msgstr "El plugin <strong>WP Debugging</strong> debe tener un archivo <code>wp-config.php</code>que sea escribible por el sistema de archivos."

#: src/Settings.php:472
msgid "Settings"
msgstr "Ajustes"

#: src/Settings.php:415
msgid "<strong>Please note:</strong> Your <code>wp-config.php</code> file must be writable by the filesystem. Any errors will result in a PHP Exception being thrown. Debug constants as documented in <a href=\"https://wordpress.org/documentation/article/debugging-in-wordpress/\">Debugging in WordPress</a>."
msgstr "<strong>Por favor, ten en cuenta:</strong> tu archivo <code>wp-config.php</code> debe tener permisos de escritura por el sistema de archivos. Cualquier error resultará en el lanzamiento de una Excepción PHP. Constantes de depuración documentadas en <a href=\"https://wordpress.org/documentation/article/debugging-in-wordpress/\">Depuración en WordPress</a>."

#: src/Settings.php:368
msgid "Select the debugging constants."
msgstr "Selecciona las constantes de depuración."

#: src/Settings.php:366
msgid "The following constants are set with plugin activation and removed with plugin deactivation."
msgstr "Las siguientes constantes se establecen con la activación del plugin y se eliminan con la desactivación del mismo."

#: src/Settings.php:354
msgid "Set WP_DISABLE_FATAL_ERROR_HANDLER to true."
msgstr "Establece WP_DISABLE_FATAL_ERROR_HANDLER en true."

#: src/Settings.php:342
msgid "Set WP_DEBUG_DISPLAY to false, default is true."
msgstr "Establece WP_DEBUG_DISPLAY en false, el valor por defecto es true."

#: src/Settings.php:330
msgid "Set WP_DEBUG to true."
msgstr "Establece WP_DEBUG en true."

#: src/Settings.php:317
msgid "Debugging Constants"
msgstr "Constantes de depuración"

#: src/Settings.php:297
msgid "Saved."
msgstr "Guardado."

