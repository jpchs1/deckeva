#: wp-admin/includes/class-wp-site-health.php:1860
msgid "Passed"
msgstr "Pasó"

#: wp-admin/includes/class-wp-site-health.php:1863
msgid "Background updates are not working as expected"
msgstr "Las actualizaciones en segundo plano no funcionan como se esperaba"

#: wp-admin/includes/class-wp-site-health.php:1872
msgid "Background updates may not be working properly"
msgstr "Es posible que las actualizaciones en segundo plano no funcionen correctamente"

