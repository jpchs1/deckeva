# BEGIN LSCACHE
# END LSCACHE
# BEGIN NON_LSCACHE
# END NON_LSCACHE

# =============================================
# BEGIN Anti-Spam & Security Hardening
# =============================================

# --- Block XML-RPC (major spam/brute-force vector) ---
<Files xmlrpc.php>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</Files>

# --- Block wp-trackback.php (trackback spam vector) ---
<Files wp-trackback.php>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</Files>

# --- Prevent PHP execution in uploads directory ---
<Directory "/wp-content/uploads/">
    <Files "*.php">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order Allow,Deny
            Deny from all
        </IfModule>
    </Files>
</Directory>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^wp-content/uploads/.*\.ph(p[345s]?|t|tml)$ - [F,L]
</IfModule>

# --- Block author enumeration (prevents user scanning) ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} ^author=([0-9]+) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# --- Block access to sensitive files ---
<FilesMatch "^(wp-config\.php|\.htaccess|\.htpasswd|readme\.html|license\.txt|wp-config-sample\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Security Headers ---
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing (blocks virus-laden attachments from being executed)
    Header always set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions Policy (restrict dangerous features)
    Header always set Permissions-Policy "geolocation=(), midi=(), camera=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), microphone=()"
    # Content Security Policy - prevent inline script injection from spam
    Header always set Content-Security-Policy "frame-ancestors 'self'"
    # Strict Transport Security (force HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Remove server signature
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# --- Block known malicious bots and spam user agents ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (ahrefs|semrush|dotbot|mj12bot|blexbot|linkfluence|sogou|yandexbot|petalbot|baiduspider|megaindex|ltx71|censys|zgrab|masscan|nmap|sqlmap|nikto|dirbuster|gobuster|nuclei|httpie|python-requests|go-http-client|curl\/|wget\/|scrapy|phantomjs|headlesschrome|selenium|puppeteer|mechanize|libwww-perl|lwp-trivial|java\/|winhttp|httpclient|nutch|harvest|emailcollector|emailsiphon|emailwolf|extractorpro|emailmagnet|webemailextractor|webbandit|emailspider) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# --- Rate limit POST requests to wp-comments-post.php ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block direct POST to comment handler without proper referrer
    RewriteCond %{REQUEST_METHOD} POST
    RewriteCond %{REQUEST_URI} ^/wp-comments-post\.php$ [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(.*\.)?deckeva\.(cl|com) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# --- Block empty referrer POST to wp-login.php (brute force protection) ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} POST
    RewriteCond %{REQUEST_URI} ^/wp-login\.php$ [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(.*\.)?deckeva\.(cl|com) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# --- Disable server signature ---
ServerSignature Off

# =============================================
# END Anti-Spam & Security Hardening
# =============================================
# BEGIN Force HTTPS
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>
# END Force HTTPS
# BEGIN www to non-www redirect
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.deckeva\.cl$ [NC]
RewriteRule ^(.*)$ https://deckeva.cl/$1 [R=301,L]
</IfModule>
# END www to non-www redirect
